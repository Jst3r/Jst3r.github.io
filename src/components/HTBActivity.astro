---
interface ActivityItem {
  name: string;
  type: 'user' | 'root' | 'challenge' | 'blood' | 'rank';
  category?: string;
  os?: 'linux' | 'windows' | 'other';
  date: string;
  points?: number;
}

interface Props {
  htbId?: string;
  username?: string;
  activities?: ActivityItem[];
}

const {
  htbId = '2051959',
  username = 'Jst3r',
  activities = [
    { name: 'Machine Own', type: 'root', os: 'linux', date: 'Recently', points: 20 },
    { name: 'Machine Own', type: 'user', os: 'linux', date: 'Recently', points: 10 },
    { name: 'Web Challenge', type: 'challenge', category: 'Web', date: 'Recently', points: 15 },
  ]
} = Astro.props;
---

<div class="htb-activity-card">
  <div class="activity-header">
    <div class="header-left">
      <span class="prompt">~/htb $</span>
      <span class="cmd">tail -f activity.log</span>
    </div>
    <div class="live-indicator">
      <span class="pulse-dot"></span>
      <span class="live-text">HTB SYNC</span>
    </div>
  </div>

  <div class="activity-list">
    {activities.map((act) => (
      <div class="activity-item">
        <div class="activity-icon">
          {act.type === 'root' && (
            <span class="icon-badge root-badge" title="Root Flag">💀</span>
          )}
          {act.type === 'user' && (
            <span class="icon-badge user-badge" title="User Flag">💻</span>
          )}
          {act.type === 'challenge' && (
            <span class="icon-badge challenge-badge" title="Challenge Flag">🚩</span>
          )}
          {act.type === 'blood' && (
            <span class="icon-badge blood-badge" title="First Blood">🩸</span>
          )}
          {act.type === 'rank' && (
            <span class="icon-badge rank-badge" title="Rank Up">⭐</span>
          )}
        </div>
        
        <div class="activity-details">
          <div class="activity-title-row">
            <span class="activity-name">{act.name}</span>
            {act.os && (
              <span class={`os-badge ${act.os}`}>
                {act.os === 'linux' ? 'Linux' : act.os === 'windows' ? 'Windows' : 'OS'}
              </span>
            )}
            {act.category && (
              <span class="cat-badge">{act.category}</span>
            )}
          </div>
          <div class="activity-meta">
            <span class="activity-type-lbl">{act.type.toUpperCase()} OWN</span>
            {act.points && <span class="activity-pts">+{act.points} pts</span>}
            <span class="activity-date">{act.date}</span>
          </div>
        </div>
      </div>
    ))}
  </div>

  <div class="activity-footer">
    <a href={`https://app.hackthebox.com/users/${htbId}?tab=activity`} target="_blank" rel="noopener noreferrer" class="activity-link">
      <span>View Full Activity Stream on HTB</span>
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
    </a>
  </div>
</div>

<style>
  .htb-activity-card {
    background: rgba(10, 15, 12, 0.75);
    border: 1px solid rgba(159, 239, 0, 0.3);
    border-radius: 4px;
    padding: 1rem;
    font-family: var(--font-mono);
    margin-top: 1rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
  }

  .activity-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(159, 239, 0, 0.2);
    margin-bottom: 0.875rem;
  }

  .header-left {
    font-size: 0.75rem;
  }

  .prompt {
    color: #9fef00;
    font-weight: 700;
  }

  .cmd {
    color: var(--text-secondary);
    margin-left: 0.25rem;
  }

  .live-indicator {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.625rem;
    color: #9fef00;
    background: rgba(159, 239, 0, 0.1);
    border: 1px solid rgba(159, 239, 0, 0.3);
    padding: 0.15rem 0.4rem;
    border-radius: 2px;
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    background-color: #9fef00;
    border-radius: 50%;
    box-shadow: 0 0 8px #9fef00;
    animation: pulse 1.8s infinite;
  }

  @keyframes pulse {
    0% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
    100% { opacity: 1; transform: scale(1); }
  }

  .activity-list {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .activity-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: rgba(20, 30, 22, 0.4);
    border: 1px solid rgba(159, 239, 0, 0.12);
    padding: 0.5rem 0.75rem;
    border-radius: 3px;
    transition: all 0.2s ease;
  }

  .activity-item:hover {
    border-color: rgba(159, 239, 0, 0.4);
    background: rgba(25, 40, 28, 0.6);
  }

  .icon-badge {
    font-size: 1rem;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .activity-details {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    gap: 0.125rem;
  }

  .activity-title-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .activity-name {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .os-badge, .cat-badge {
    font-size: 0.625rem;
    padding: 0.05rem 0.35rem;
    border-radius: 2px;
    text-transform: uppercase;
    font-weight: 600;
  }

  .os-badge.linux {
    background: rgba(255, 170, 0, 0.15);
    color: #ffaa00;
    border: 1px solid rgba(255, 170, 0, 0.3);
  }

  .os-badge.windows {
    background: rgba(0, 170, 255, 0.15);
    color: #00aaff;
    border: 1px solid rgba(0, 170, 255, 0.3);
  }

  .cat-badge {
    background: rgba(159, 239, 0, 0.15);
    color: #9fef00;
    border: 1px solid rgba(159, 239, 0, 0.3);
  }

  .activity-meta {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 0.6875rem;
    color: var(--text-muted);
  }

  .activity-type-lbl {
    color: #9fef00;
    font-weight: 600;
  }

  .activity-pts {
    color: #00ffaa;
  }

  .activity-date {
    margin-left: auto;
    font-size: 0.625rem;
  }

  .activity-footer {
    margin-top: 0.875rem;
    padding-top: 0.625rem;
    border-top: 1px solid rgba(159, 239, 0, 0.15);
    text-align: center;
  }

  .activity-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.75rem;
    color: #9fef00;
    text-decoration: none;
    font-weight: 600;
    transition: opacity 0.2s;
  }

  .activity-link:hover {
    opacity: 0.8;
    text-decoration: underline;
  }
</style>
