---
interface Props {
  htbId?: string;
  username?: string;
  rank?: string;
  userOwns?: number;
  rootOwns?: number;
  challenges?: number;
  profileUrl?: string;
}

const {
  htbId = '',
  username = 'Jst3r',
  rank = 'Pro Hacker',
  userOwns,
  rootOwns,
  challenges,
  profileUrl = htbId ? `https://app.hackthebox.com/users/${htbId}` : 'https://app.hackthebox.com/profile/overview'
} = Astro.props;
---

<div class="htb-card">
  <div class="htb-header">
    <div class="htb-logo-title">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="var(--accent)" xmlns="http://www.w3.org/2000/svg">
        <path d="M11.996 0L1.779 5.899v12.202l10.217 5.899 10.225-5.899V5.899L11.996 0zm7.884 16.658l-7.884 4.551-7.876-4.551V7.342l7.876-4.55 7.884 4.55v9.316z"/>
        <path d="M12 9.406l-4.148 2.395v4.79L12 18.986l4.148-2.395v-4.79L12 9.406z"/>
      </svg>
      <span class="htb-title">Hack The Box</span>
    </div>
    {htbId && <span class="htb-badge-live">LIVE</span>}
  </div>

  {htbId ? (
    <div class="htb-badge-container">
      <a href={profileUrl} target="_blank" rel="noopener noreferrer" class="htb-badge-link">
        <img 
          src={`https://www.hackthebox.eu/badge/image/${htbId}`} 
          alt={`${username}'s Hack The Box Badge`} 
          class="htb-dynamic-badge"
          loading="lazy"
        />
      </a>
    </div>
  ) : (
    <div class="htb-custom-stats">
      <div class="htb-rank-row">
        <span class="htb-rank-label">Rank</span>
        <span class="htb-rank-val">{rank}</span>
      </div>
      {(userOwns !== undefined || rootOwns !== undefined) && (
        <div class="htb-metrics-grid">
          {userOwns !== undefined && (
            <div class="htb-metric">
              <span class="htb-metric-num">{userOwns}</span>
              <span class="htb-metric-lbl">User Owns</span>
            </div>
          )}
          {rootOwns !== undefined && (
            <div class="htb-metric">
              <span class="htb-metric-num">{rootOwns}</span>
              <span class="htb-metric-lbl">Root Owns</span>
            </div>
          )}
          {challenges !== undefined && (
            <div class="htb-metric">
              <span class="htb-metric-num">{challenges}</span>
              <span class="htb-metric-lbl">Challenges</span>
            </div>
          )}
        </div>
      )}
      <a href={profileUrl} target="_blank" rel="noopener noreferrer" class="htb-profile-btn">
        View HTB Profile &rarr;
      </a>
    </div>
  )}
</div>

<style>
  .htb-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.875rem 1rem;
    margin-top: 0.75rem;
    transition: border-color var(--transition);
  }

  .htb-card:hover {
    border-color: var(--accent);
  }

  .htb-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.625rem;
  }

  .htb-logo-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .htb-title {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .htb-badge-live {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    background: var(--accent-dim);
    color: var(--accent);
    border: 1px solid var(--accent);
    padding: 0.1rem 0.35rem;
    border-radius: 2px;
    font-weight: 700;
  }

  .htb-badge-container {
    display: flex;
    justify-content: center;
    overflow: hidden;
  }

  .htb-badge-link {
    display: block;
    width: 100%;
  }

  .htb-dynamic-badge {
    width: 100%;
    height: auto;
    border-radius: 2px;
    display: block;
  }

  .htb-custom-stats {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .htb-rank-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .htb-rank-label {
    color: var(--text-muted);
  }

  .htb-rank-val {
    color: var(--accent);
    font-weight: 700;
  }

  .htb-metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(60px, 1fr));
    gap: 0.5rem;
    margin-top: 0.25rem;
  }

  .htb-metric {
    display: flex;
    flex-direction: column;
    align-items: center;
    background: var(--bg-primary);
    padding: 0.375rem;
    border-radius: 2px;
  }

  .htb-metric-num {
    font-family: var(--font-mono);
    font-weight: 800;
    font-size: 0.875rem;
    color: var(--text-primary);
  }

  .htb-metric-lbl {
    font-size: 0.625rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
    text-transform: uppercase;
  }

  .htb-profile-btn {
    display: inline-block;
    margin-top: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--accent);
    text-decoration: none;
    font-weight: 600;
    transition: opacity 0.2s;
  }

  .htb-profile-btn:hover {
    opacity: 0.8;
    text-decoration: underline;
  }
</style>
