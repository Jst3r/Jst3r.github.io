

<!-- Hidden Terminal -->
<div id="terminal-overlay" class="ee-terminal-overlay">
  <div class="ee-terminal-window">
    <div class="ee-terminal-titlebar">
      <div class="ee-terminal-dots">
        <span class="ee-dot ee-dot-red"></span>
        <span class="ee-dot ee-dot-yellow"></span>
        <span class="ee-dot ee-dot-green"></span>
      </div>
      <span class="ee-terminal-title">jst3r@blog:~</span>
      <button id="terminal-close" class="ee-terminal-close-btn">×</button>
    </div>
    <div class="ee-terminal-body" id="terminal-body">
      <div class="ee-terminal-output" id="terminal-output">
        <p>Welcome to Jst3r's secret terminal.</p>
        <p>Type <span class="ee-cmd-highlight">help</span> for available commands.</p>
      </div>
      <div class="ee-terminal-input-line">
        <span class="ee-terminal-ps1">jst3r@blog:~$&nbsp;</span>
        <input type="text" id="terminal-input" class="ee-terminal-input" autocomplete="off" spellcheck="false" />
      </div>
    </div>
  </div>
</div>

<!-- Matrix Rain Canvas -->
<canvas id="matrix-canvas" class="ee-matrix-canvas"></canvas>

<!-- Achievement Toast -->
<div id="achievement-toast" class="ee-achievement-toast">
  <span class="ee-achievement-icon">🏆</span>
  <div>
    <strong>Achievement Unlocked</strong>
    <p>You're persistent. That's how CTFs work.</p>
  </div>
</div>



<style>


  /* ===== Hidden Terminal ===== */
  .ee-terminal-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(0, 0, 0, 0.85);
    display: none;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(4px);
  }

  .ee-terminal-overlay.open {
    display: flex;
  }

  .ee-terminal-window {
    width: min(650px, 90vw);
    max-height: 70vh;
    background: #0c0c0c;
    border: 2px solid #3f3f46;
    display: flex;
    flex-direction: column;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.6);
  }

  .ee-terminal-titlebar {
    display: flex;
    align-items: center;
    padding: 0.5rem 0.75rem;
    background: #1a1a1a;
    border-bottom: 1px solid #3f3f46;
    gap: 0.75rem;
  }

  .ee-terminal-dots {
    display: flex;
    gap: 6px;
  }

  .ee-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .ee-dot-red { background: #ef4444; }
  .ee-dot-yellow { background: #facc15; }
  .ee-dot-green { background: #22c55e; }

  .ee-terminal-title {
    flex: 1;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: #71717a;
    font-weight: 600;
  }

  .ee-terminal-close-btn {
    background: none;
    border: none;
    color: #71717a;
    font-size: 1.25rem;
    cursor: pointer;
    padding: 0 0.25rem;
    font-family: var(--font-mono);
    line-height: 1;
  }

  .ee-terminal-close-btn:hover {
    color: #ef4444;
  }

  .ee-terminal-body {
    padding: 1rem;
    overflow-y: auto;
    flex: 1;
    max-height: 400px;
  }

  .ee-terminal-output {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: #a1a1aa;
    line-height: 1.8;
  }

  .ee-terminal-output p {
    margin: 0;
  }

  .ee-terminal-output .ee-cmd-highlight {
    color: #facc15;
    font-weight: 600;
  }

  .ee-terminal-output .ee-output-accent {
    color: #22c55e;
  }

  .ee-terminal-output .ee-output-error {
    color: #ef4444;
  }

  .ee-terminal-output .ee-output-flag {
    color: #facc15;
    font-weight: 700;
  }

  .ee-terminal-input-line {
    display: flex;
    align-items: center;
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .ee-terminal-ps1 {
    color: #22c55e;
    font-weight: 700;
    white-space: nowrap;
  }

  .ee-terminal-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    color: #d4d4d8;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    caret-color: #22c55e;
  }

  /* ===== Matrix Canvas ===== */
  .ee-matrix-canvas {
    position: fixed;
    inset: 0;
    z-index: 9998;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .ee-matrix-canvas.active {
    opacity: 0.6;
  }

  /* ===== Achievement Toast ===== */
  .ee-achievement-toast {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    z-index: 10002;
    background: #1a1a1a;
    border: 2px solid #facc15;
    padding: 1rem 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: #d4d4d8;
    transform: translateY(150%);
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 4px 4px 0px #facc15;
  }

  .ee-achievement-toast.show {
    transform: translateY(0);
  }

  .ee-achievement-toast strong {
    color: #facc15;
    display: block;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 0.125rem;
  }

  .ee-achievement-toast p {
    margin: 0;
    color: #a1a1aa;
    font-size: 0.75rem;
  }

  .ee-achievement-icon {
    font-size: 1.5rem;
  }





  /* ===== Page glitch (for sudo rm -rf) ===== */
  @keyframes ee-page-glitch {
    0%   { filter: none; transform: none; }
    10%  { filter: hue-rotate(90deg) saturate(3); transform: translate(-3px, 2px) skewX(1deg); }
    20%  { filter: invert(1); transform: translate(2px, -1px); }
    30%  { filter: hue-rotate(180deg); transform: translate(-1px, 3px) skewX(-1deg); }
    40%  { filter: saturate(5) brightness(1.5); transform: translate(3px, 1px); }
    50%  { filter: invert(1) hue-rotate(270deg); transform: translate(-2px, -2px) skewY(1deg); }
    60%  { filter: hue-rotate(45deg); transform: translate(1px, 2px); }
    70%  { filter: none; transform: translate(-3px, -1px) skewX(0.5deg); }
    80%  { filter: invert(0.5) saturate(2); transform: translate(2px, 3px); }
    90%  { filter: hue-rotate(315deg); transform: translate(-1px, -3px); }
    100% { filter: none; transform: none; }
  }

  :global(.ee-page-glitch) {
    animation: ee-page-glitch 1.5s ease-in-out !important;
  }
</style>

<script>



  // ===== 3. Hidden Terminal =====
  (() => {
    const overlay = document.getElementById('terminal-overlay')!;
    const input = document.getElementById('terminal-input') as HTMLInputElement;
    const output = document.getElementById('terminal-output')!;
    const body = document.getElementById('terminal-body')!;
    const closeBtn = document.getElementById('terminal-close')!;

    const commands: Record<string, string> = {
      help: `Available commands:
  <span class="ee-cmd-highlight">whoami</span>       — Who am I?
  <span class="ee-cmd-highlight">ls</span>           — List files
  <span class="ee-cmd-highlight">cat flag.txt</span> — Read the flag
  <span class="ee-cmd-highlight">cat /etc/flag.txt</span> — Read the flag
  <span class="ee-cmd-highlight">uname -a</span>     — System info
  <span class="ee-cmd-highlight">uptime</span>       — How long has this blog been running?
  <span class="ee-cmd-highlight">sudo rm -rf /</span> — Don't do it.
  <span class="ee-cmd-highlight">clear</span>        — Clear terminal
  <span class="ee-cmd-highlight">exit</span>         — Close terminal`,
      whoami: '<span class="ee-output-accent">jst3r</span> — Security Researcher & Reverse Engineer from Morocco 🇲🇦',
      ls: `<span class="ee-output-accent">drwxr-xr-x</span>  blog/
<span class="ee-output-accent">drwxr-xr-x</span>  writeups/
<span class="ee-output-accent">-rw-r--r--</span>  flag.txt
<span class="ee-output-accent">-rw-------</span>  .secret_plans
<span class="ee-output-accent">-rwx------</span>  exploit.py`,
      'cat flag.txt': '<span class="ee-output-flag">flag{y0u_f0und_th3_t3rm1nal}</span>',
      'cat /etc/flag.txt': '<span class="ee-output-flag">flag{y0u_f0und_th3_t3rm1nal}</span>',
      'uname -a': 'JstOS 1.337 jst3r-blog x86_64 GNU/Hax',
      uptime: `up ${Math.floor((Date.now() - new Date('2026-01-18').getTime()) / 86400000)} days, running on pure caffeine and CTF writeups`,
      'sudo rm -rf /': '<span class="ee-output-error">Permission denied. Nice try though. 😏</span>',
      'cat .secret_plans': '<span class="ee-output-error">Permission denied: classified 🔒</span>',
      'cat exploit.py': '<span class="ee-output-accent">#!/usr/bin/env python3\nprint("TODO: write actual exploit")\n# this is fine ☕</span>',
    };

    function openTerminal() {
      overlay.classList.add('open');
      setTimeout(() => input.focus(), 100);
    }

    function closeTerminal() {
      overlay.classList.remove('open');
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === '`' && e.ctrlKey) {
        e.preventDefault();
        overlay.classList.contains('open') ? closeTerminal() : openTerminal();
      }
      if (e.key === 'Escape' && overlay.classList.contains('open')) {
        closeTerminal();
      }
    });

    closeBtn.addEventListener('click', closeTerminal);
    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) closeTerminal();
    });

    input.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter') return;
      const cmd = input.value.trim().toLowerCase();
      input.value = '';
      if (!cmd) return;

      // Echo the command
      const cmdLine = document.createElement('p');
      cmdLine.innerHTML = `<span class="ee-terminal-ps1">jst3r@blog:~$</span> ${cmd}`;
      output.appendChild(cmdLine);

      if (cmd === 'clear') {
        output.innerHTML = '';
      } else if (cmd === 'exit') {
        closeTerminal();
      } else if (cmd === 'sudo rm -rf /') {
        const resp = document.createElement('p');
        resp.innerHTML = commands[cmd];
        output.appendChild(resp);
        // Glitch the page
        document.body.classList.add('ee-page-glitch');
        setTimeout(() => document.body.classList.remove('ee-page-glitch'), 1500);
      } else if (commands[cmd]) {
        const resp = document.createElement('p');
        resp.innerHTML = commands[cmd];
        resp.style.whiteSpace = 'pre-wrap';
        output.appendChild(resp);
      } else {
        const err = document.createElement('p');
        err.innerHTML = `<span class="ee-output-error">bash: ${cmd}: command not found</span>`;
        output.appendChild(err);
      }

      body.scrollTop = body.scrollHeight;
    });
  })();

  // ===== 4. Matrix Rain =====
  (() => {
    const canvas = document.getElementById('matrix-canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    let animationId: number | null = null;
    let active = false;
    let clickCount = 0;
    let clickTimer: ReturnType<typeof setTimeout> | null = null;

    const avatar = document.querySelector('.avatar-img');
    if (avatar) {
      avatar.addEventListener('click', (e) => {
        e.preventDefault();
        clickCount++;
        if (clickTimer) clearTimeout(clickTimer);
        clickTimer = setTimeout(() => { clickCount = 0; }, 2000);

        if (clickCount >= 5) {
          clickCount = 0;
          active = !active;
          canvas.classList.toggle('active', active);
          if (active) startMatrix();
          else stopMatrix();
        }
      });
    }

    const chars = 'アイウエオカキクケコサシスセソタチツテトナニヌネノハヒフヘホマミムメモヤユヨラリルレロワヲン0123456789ABCDEF{}flag';
    const fontSize = 14;
    let columns: number[] = [];

    function resize() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
      const colCount = Math.floor(canvas.width / fontSize);
      columns = Array(colCount).fill(0).map(() => Math.random() * canvas.height / fontSize | 0);
    }

    function draw() {
      ctx.fillStyle = 'rgba(10, 10, 10, 0.05)';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.fillStyle = '#22c55e';
      ctx.font = `${fontSize}px monospace`;

      for (let i = 0; i < columns.length; i++) {
        const char = chars[Math.floor(Math.random() * chars.length)];
        ctx.fillText(char, i * fontSize, columns[i] * fontSize);
        if (columns[i] * fontSize > canvas.height && Math.random() > 0.975) {
          columns[i] = 0;
        }
        columns[i]++;
      }
      animationId = requestAnimationFrame(draw);
    }

    function startMatrix() {
      resize();
      draw();
    }

    function stopMatrix() {
      if (animationId) cancelAnimationFrame(animationId);
      animationId = null;
      ctx.clearRect(0, 0, canvas.width, canvas.height);
    }

    window.addEventListener('resize', () => { if (active) resize(); });
  })();



  // ===== 6. Gallery of Failures Click Counter =====
  (() => {
    const headings = document.querySelectorAll('.about-section h2');
    const galleryHeading = Array.from(headings).find(h => h.textContent?.includes('Gallery'));
    if (!galleryHeading) return;

    let clickCount = 0;
    let shown = false;

    galleryHeading.addEventListener('click', () => {
      if (shown) return;
      clickCount++;
      if (clickCount >= 10) {
        shown = true;
        const toast = document.getElementById('achievement-toast');
        toast?.classList.add('show');
        setTimeout(() => toast?.classList.remove('show'), 4000);
      }
    });
  })();


</script>
