---
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/blog/', label: 'Blog' },
];
---

<header class="header">
  <div class="container header-inner">
    <nav class="nav" id="nav">
    {navLinks.map((link) => (
      <a
        href={link.href}
        class:list={['nav-link', { active: currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href)) }]}
      >
        {link.label}
      </a>
    ))}
    </nav>
    <button class="mobile-toggle" id="mobile-toggle" aria-label="Toggle menu">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="3" y1="6" x2="21" y2="6" class="line-top" />
        <line x1="3" y1="12" x2="21" y2="12" class="line-mid" />
        <line x1="3" y1="18" x2="21" y2="18" class="line-bot" />
      </svg>
    </button>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(8px);
    height: var(--header-height);
    display: flex;
    align-items: center;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .header-left {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .logo-avatar {
    width: 26px;
    height: 26px;
    border: 1px solid var(--accent);
    object-fit: cover;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 1.15rem;
    font-weight: 900;
    color: var(--text-primary);
    text-decoration: none;
    letter-spacing: 0.05em;
  }

  .logo:hover .logo-text {
    color: var(--accent);
  }

  .logo-text {
    color: var(--text-primary);
  }

  .nav {
    display: flex;
    gap: 0.125rem;
  }

  .nav-link {
    padding: 0.4rem 0.75rem;
    font-size: 0.875rem;
    color: var(--text-secondary);
    transition: all var(--transition);
    font-weight: 700;
    text-transform: uppercase;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    border: var(--border-width) solid transparent;
  }

  .nav-link:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-dim);
  }

  .nav-link.active {
    color: #0a0a0a;
    background: var(--accent);
    border-color: var(--accent);
  }

  .mobile-toggle {
    display: none;
    background: none;
    border: var(--border-width) solid var(--border);
    color: var(--text-secondary);
    cursor: pointer;
    padding: 0.4rem;
  }

  .mobile-toggle:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  @media (max-width: 768px) {
    .mobile-toggle {
      display: flex;
    }

    .nav {
      display: none;
      position: absolute;
      top: var(--header-height);
      left: 0;
      right: 0;
      background: var(--bg-primary);
      border-bottom: var(--border-width) solid var(--border);
      flex-direction: column;
      padding: 0.5rem 1rem;
    }

    .nav.open {
      display: flex;
    }

    .nav-link {
      padding: 0.75rem 1rem;
    }
  }
</style>

<script>
  const toggle = document.getElementById('mobile-toggle');
  const nav = document.getElementById('nav');
  toggle?.addEventListener('click', () => {
    nav?.classList.toggle('open');
  });
</script>
