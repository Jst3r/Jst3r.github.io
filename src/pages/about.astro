---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About" description="About Jst3r — Cybersecurity Researcher, Reverse Engineer, and CTF Player">
  <section class="section">
    <div class="container about-page">
      <div class="about-header">
        <div class="about-avatar">
          <img src="/profile.jpg" alt="Jst3r" class="avatar-img" />
        </div>
        <div class="about-intro">
          <h1 class="about-name">Jst3r</h1>
          <p class="about-role">Security Researcher & Reverse Engineer</p>
          <div class="about-links">
            <a href="https://github.com/Jst3r" target="_blank" rel="noopener noreferrer" class="about-social">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
              GitHub
            </a>
            <a href="https://x.com/whoisJst3r" target="_blank" rel="noopener noreferrer" class="about-social">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              @whoisJst3r
            </a>
            <a href="/resume.pdf" download class="about-social resume-link">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              Resume
            </a>
          </div>
        </div>
      </div>

      <div class="about-body">
        <div class="about-section">
          <h2>About</h2>
          <p>
            I'm a cybersecurity enthusiast from Morocco with a passion for understanding how software works at its lowest level. 
            My primary focus is on <strong>Reverse Engineering</strong>, and I've recently been 
            expanding into <strong>Web Pentesting</strong> as well.
          </p>
          <p>
            When I'm not reversing binaries or testing web apps, I write about my findings and share 
            my thought process through detailed writeups on this blog.
          </p>
        </div>

        <div class="about-section">
          <h2>Skills & Tools</h2>
          <div class="skills-grid">
            <div class="skill-group">
              <h3>Programming</h3>
              <ul>
                <li><span class="bullet">▹</span> C / C++</li>
                <li><span class="bullet">▹</span> Python</li>
                <li><span class="bullet">▹</span> Bash Scripting</li>
                <li><span class="bullet">▹</span> x86/x64 Assembly</li>
              </ul>
            </div>
            <div class="skill-group">
              <h3>Security</h3>
              <ul>
                <li><span class="bullet">▹</span> Reverse Engineering</li>
                <li><span class="bullet">▹</span> Web Application Pentesting</li>
              </ul>
            </div>
            <div class="skill-group">
              <h3>Tools</h3>
              <ul>
                <li><span class="bullet">▹</span> GDB / GEF / pwndbg</li>
                <li><span class="bullet">▹</span> Ghidra & IDA Pro</li>
                <li><span class="bullet">▹</span> Radare2</li>
                <li><span class="bullet">▹</span> Burp Suite</li>
              </ul>
            </div>
            <div class="skill-group">
              <h3>Systems</h3>
              <ul>
                <li><span class="bullet">▹</span> Linux (Arch, Debian)</li>
                <li><span class="bullet">▹</span> Windows</li>
                <li><span class="bullet">▹</span> macOS</li>
                <li><span class="bullet">▹</span> Networking</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-page {
    max-width: 800px;
  }

  .about-header {
    display: flex;
    align-items: center;
    gap: 2rem;
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: var(--border-width) solid var(--border);
  }

  .avatar-img {
    width: 80px;
    height: 80px;
    border: var(--border-width) solid var(--border);
    box-shadow: var(--shadow);
    object-fit: cover;
  }

  .about-name {
    font-size: 1.75rem;
    font-weight: 900;
    margin-bottom: 0.25rem;
    text-transform: uppercase;
  }

  .about-role {
    color: var(--text-secondary);
    font-size: 0.9375rem;
    margin-bottom: 0.75rem;
  }

  .about-links {
    display: flex;
    gap: 1rem;
  }

  .about-social {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
    transition: color var(--transition);
    font-weight: 600;
    font-family: var(--font-mono);
  }

  .about-social:hover {
    color: var(--accent);
  }

  .about-body {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .about-section h2 {
    font-size: 1.25rem;
    font-weight: 800;
    margin-bottom: 1rem;
    color: var(--text-primary);
    text-transform: uppercase;
  }

  .about-section p {
    color: var(--text-secondary);
    line-height: 1.8;
    margin-bottom: 1rem;
  }

  .about-section p strong {
    color: var(--text-primary);
    font-weight: 600;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  .skill-group h3 {
    font-size: 0.875rem;
    font-weight: 800;
    color: var(--accent);
    margin-bottom: 0.75rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
  }

  .skill-group ul {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .skill-group li {
    font-size: 0.875rem;
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .bullet {
    color: var(--accent);
    font-size: 0.75rem;
  }

  @media (max-width: 768px) {
    .about-header {
      flex-direction: column;
      text-align: center;
    }

    .about-links {
      justify-content: center;
    }

    .skills-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
