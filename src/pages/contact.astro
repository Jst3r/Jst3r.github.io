---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact" description="Get in touch with Jst3r">
  <section class="section">
    <div class="container contact-page">
      <h1 class="section-title">Contact</h1>
      <p class="section-subtitle">Feel free to reach out — I'm always open to collaborating or chatting about security.</p>

      <div class="contact-grid">
        <a href="https://github.com/Jst3r" target="_blank" rel="noopener noreferrer" class="contact-card">
          <div class="contact-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
          </div>
          <div class="contact-info">
            <h3>GitHub</h3>
            <span>@Jst3r</span>
          </div>
          <svg class="contact-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17l9.2-9.2M17 17V7.8H7.8"/></svg>
        </a>

        <a href="https://x.com/whoisJst3r" target="_blank" rel="noopener noreferrer" class="contact-card">
          <div class="contact-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </div>
          <div class="contact-info">
            <h3>X / Twitter</h3>
            <span>@whoisJst3r</span>
          </div>
          <svg class="contact-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17l9.2-9.2M17 17V7.8H7.8"/></svg>
        </a>
      </div>

      <div class="contact-note">
        <p>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
          For CTF team invites, collaboration, or anything security-related,
          DM me on X. I usually respond within a day.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-page {
    max-width: 600px;
  }

  .contact-grid {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .contact-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: all var(--transition);
    text-decoration: none;
  }

  .contact-card:hover {
    border-color: var(--border-hover);
    background: var(--bg-card-hover);
    transform: translateX(4px);
  }

  .contact-icon {
    color: var(--text-muted);
    transition: color var(--transition);
    flex-shrink: 0;
  }

  .contact-card:hover .contact-icon {
    color: var(--accent);
  }

  .contact-info {
    flex-grow: 1;
  }

  .contact-info h3 {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.125rem;
  }

  .contact-info span {
    font-size: 0.8125rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .contact-arrow {
    color: var(--text-muted);
    flex-shrink: 0;
    transition: all var(--transition);
  }

  .contact-card:hover .contact-arrow {
    color: var(--accent);
    transform: translate(2px, -2px);
  }

  .contact-note {
    padding: 1rem 1.25rem;
    background: var(--accent-dim);
    border: 1px solid rgba(59, 130, 246, 0.15);
    border-radius: var(--radius);
  }

  .contact-note p {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .contact-note svg {
    color: var(--accent);
    flex-shrink: 0;
    margin-top: 0.125rem;
  }
</style>
