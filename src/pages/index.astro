---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.hidden)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<BaseLayout title="Home" description="Jst3r — Security Researcher, Reverse Engineer & CTF Player based in Morocco.">
  <section class="home-section">
    <div class="page-layout">
      <!-- Left Sidebar -->
      <aside class="sidebar">
        <div class="profile-card">
          <div class="profile-top">
            <img src="/profile.jpg" alt="Jst3r Profile" class="avatar-img" />
            <div class="profile-info">
              <h1 class="about-name">Jst3r</h1>
              <p class="about-role">Security Research • Rev • CTF</p>
            </div>
          </div>

          <div class="about-bio">
            <p>
              Cybersecurity researcher & CTF player from <strong>Morocco</strong> specializing in 
              <strong>Security Research</strong>, <strong>Reverse Engineering</strong>, and <strong>Binary Exploitation</strong>.
            </p>
          </div>

          <div class="divider"></div>

          <!-- CTF Achievements -->
          <div class="about-section">
            <h2>Gallery of Failures</h2>
            <ul class="achievements-list">
              <li><span class="bullet">▹</span> 8th place — Cyber Odyssey Finals CTF 2025</li>
              <li><span class="bullet">▹</span> 9th place — International Days of Hacking 2026</li>
            </ul>
          </div>

          <div class="divider"></div>

          <!-- Social & Platform Profiles -->
          <div class="about-section">
            <h2>Profiles & Links</h2>
            <div class="about-links">
              <a href="https://github.com/Jst3r" target="_blank" rel="noopener noreferrer" class="about-social">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
                GitHub
              </a>
              <a href="https://x.com/whoisJst3r" target="_blank" rel="noopener noreferrer" class="about-social">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                Twitter
              </a>
              <a href="https://app.hackthebox.com/users/2051959" target="_blank" rel="noopener noreferrer" class="about-social">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M11.996 0L1.779 5.899v12.202l10.217 5.899 10.225-5.899V5.899L11.996 0zm7.884 16.658l-7.884 4.551-7.876-4.551V7.342l7.876-4.55 7.884 4.55v9.316z"/></svg>
                Hack The Box
              </a>
              <a href="https://tryhackme.com/p/Jst3r" target="_blank" rel="noopener noreferrer" class="about-social">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1L2 6v12l10 5 10-5V6L12 1zm0 2.236l7.5 3.75v9.028L12 19.764 4.5 16.014V6.986L12 3.236z"/></svg>
                TryHackMe
              </a>
              <a href="https://pwn.college/hacker/Jst3r" target="_blank" rel="noopener noreferrer" class="about-social">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
                pwn.college
              </a>
              <a href="/resume.pdf" download class="about-social">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                Resume
              </a>
            </div>
          </div>
        </div>
      </aside>

      <!-- Main Posts Area -->
      <div class="main-content">
        <div class="posts-header">
          <span class="terminal-prompt">~/blog $</span>
          <span class="terminal-cmd">ls -la posts/</span>
        </div>

        <div class="posts-list">
          {posts.map((post) => (
            <div class="post-item">
              <PostCard
                title={post.data.title}
                description={post.data.description}
                date={post.data.date}
                tags={post.data.tags}
                slug={post.slug}
                readTime={post.data.readTime}
              />
            </div>
          ))}
        </div>

        {posts.length === 0 && (
          <div class="empty-state">
            <p>No posts yet. Check back soon!</p>
          </div>
        )}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .home-section {
    min-height: calc(100vh - var(--header-height));
    padding: 2.5rem 1.5rem;
  }

  .page-layout {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 2.5rem;
    max-width: 1200px;
    margin: 0 auto;
    align-items: start;
  }

  .sidebar {
    position: sticky;
    top: calc(var(--header-height) + 1.5rem);
  }

  .profile-card {
    padding: 1.5rem;
    border: 1px solid var(--border);
    background: var(--bg-card);
    border-radius: 4px;
  }

  .profile-top {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .avatar-img {
    width: 54px;
    height: 54px;
    border: 2px solid var(--accent);
    object-fit: cover;
    flex-shrink: 0;
  }

  .about-name {
    font-size: 1.25rem;
    font-weight: 800;
    margin-bottom: 0.15rem;
    text-transform: uppercase;
    line-height: 1.1;
  }

  .about-role {
    color: var(--accent);
    font-size: 0.6875rem;
    font-family: var(--font-mono);
    font-weight: 700;
    text-transform: uppercase;
  }

  .about-bio p {
    color: var(--text-secondary);
    font-size: 0.8125rem;
    line-height: 1.6;
  }

  .about-bio p strong {
    color: var(--text-primary);
  }

  .divider {
    height: 1px;
    background: var(--border);
    margin: 1.25rem 0;
  }

  .about-section h2 {
    font-size: 0.6875rem;
    font-weight: 800;
    margin-bottom: 0.625rem;
    color: var(--text-muted);
    text-transform: uppercase;
    font-family: var(--font-mono);
    letter-spacing: 0.08em;
  }

  .achievements-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
  }

  .achievements-list li {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    line-height: 1.5;
  }

  .bullet {
    color: var(--accent);
    font-size: 0.75rem;
    margin-top: 0.125rem;
    flex-shrink: 0;
  }

  .about-links {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .about-social {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.8125rem;
    color: var(--text-secondary);
    font-weight: 600;
    font-family: var(--font-mono);
    text-decoration: none;
    padding: 0.25rem 0;
    transition: color 0.2s;
  }

  .about-social:hover {
    color: var(--accent);
  }

  .main-content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .posts-header {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }

  .terminal-prompt {
    color: var(--accent);
    font-weight: 700;
  }

  .terminal-cmd {
    color: var(--text-secondary);
    margin-left: 0.35rem;
  }

  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  @media (max-width: 868px) {
    .page-layout {
      grid-template-columns: 1fr;
    }
  }
</style>
